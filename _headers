/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Dosya adları sabit, cache kırma index.html'deki ?v= parametresiyle yapılıyor.
# Bir asset düzenledikten sonra ./tools/surum-yukselt.sh çalıştırın.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
