# Yerel geliştirme için: bu dosyayı `.dev.vars` adıyla kopyalayıp doldurun.
# `.dev.vars` .gitignore'da — asla commit'lenmez.
# Canlıda bu değerler Cloudflare secret'ı olarak tanımlanır (bkz. README).

# Rastgele uzun bir dize. Oturum çerezlerini imzalar.
AUTH_SECRET=

# Dashboard giriş PIN'i
APP_PIN=

# Giderler sayfası için ikinci PIN (boş bırakılırsa ikinci kapı devre dışı kalır)
EXPENSES_PIN=

# /api/ingest için Bearer token
AI_INGEST_TOKEN=

# Apps Script Web App adresi (.../exec)
GAS_EXEC_URL=

# Google Sheets "yayınlanmış" CSV adresleri
SHEET_CSV_REVENUE=
SHEET_CSV_INVENTORY=
SHEET_CSV_ORDERS=
SHEET_CSV_EXPENSES=
